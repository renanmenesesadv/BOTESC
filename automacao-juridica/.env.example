# ============================================
# AUTOMAÇÃO JURÍDICA — VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no Git
# ============================================

# --- Chave de Ativação do Sistema ---
# UUID v4 gerado pelo admin. Sem ela, nada funciona.
# Gere com: python -c "import uuid; print(uuid.uuid4())"
SYSTEM_ACTIVATION_KEY=

# --- Telegram ---
# Token do bot obtido via @BotFather
TELEGRAM_BOT_TOKEN=

# --- Anthropic (Claude) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- OpenAI (GPT Vision) ---
# https://platform.openai.com/
OPENAI_API_KEY=

# --- Google ---
# Caminho para o arquivo credentials.json do Google Cloud
GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json

# --- Google Drive ---
# ID da pasta raiz "ESCRITÓRIO JURÍDICO" no Drive
DRIVE_ROOT_FOLDER_ID=

# --- Google Sheets ---
# ID da planilha "AUTOMAÇÃO JURÍDICA — BASE"
GOOGLE_SHEETS_ID=

# --- n8n ---
# URL base do n8n
N8N_BASE_URL=http://localhost:5678

# --- Caminho do Projeto ---
# Caminho absoluto para a pasta automacao-juridica
PROJECT_PATH=/caminho/para/automacao-juridica
