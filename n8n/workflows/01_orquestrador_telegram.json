{
  "name": "Orquestrador Telegram (n8n → Bot API)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "1-webhook-telegram",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "bot-telegram-recebimento"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://bot-api:3000/telegram/process-message",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2-http-bot-api",
      "name": "Enviar para Bot API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Enviar para Bot API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
