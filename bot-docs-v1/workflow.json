      "id": "01-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const TELEGRAM_AUTORIZADO = '319858355';\nconst DRIVE_ROOT_ID = '1tIhxnR8PU-GbR0HClnwGydMcqd6zu5sl';\n\nconst msg = $input.first().json.message || $input.first().json;\nconst fromId = String(msg.from?.id || '');\nconst chatId = msg.chat?.id;\nconst caption = (msg.caption || '').trim();\n\nlet fileId = '';\nlet fileName = '';\n\nif (msg.document) {\n  fileId = msg.document.file_id;\n  fileName = msg.document.file_name || ('arquivo_' + Date.now());\n} else if (msg.photo && msg.photo.length) {\n  fileId = msg.photo[msg.photo.length - 1].file_id;\n  fileName = 'foto_' + Date.now() + '.jpg';\n}\n\nconst idx = caption.indexOf(' - ');\nconst cliente = idx > -1 ? caption.substring(0, idx).trim() : '';\nconst categoria = idx > -1 ? caption.substring(idx + 3).trim() : '';\n\nconst sanitize = (s) => (s || '').replace(/[\\/\\\\<>:\"|?*]/g, '_').trim();\nconst clienteSafe = sanitize(cliente);\nconst categoriaSafe = sanitize(categoria);\n\nlet valido = true;\nlet mensagem_erro = '';\n\nif (fromId !== TELEGRAM_AUTORIZADO) {\n  valido = false;\n  mensagem_erro = 'Acesso nao autorizado.\\nSeu ID: ' + fromId;\n} else if (!fileId) {\n  valido = false;\n  mensagem_erro = 'Envie um arquivo (PDF ou foto) com a legenda no formato:\\n\\nCliente - Categoria\\n\\nExemplo: Dona Maria - Medicamentos';\n} else if (!clienteSafe || !categoriaSafe) {\n  valido = false;\n  mensagem_erro = 'Legenda invalida. Use o formato:\\n\\nCliente - Categoria\\n\\nExemplo: Dona Maria - Medicamentos';\n}\n\nreturn [{\n  json: {\n    valido,\n    mensagem_erro,\n    chat_id: chatId,\n    file_id: fileId,\n    file_name: fileName,\n    cliente: clienteSafe,\n    categoria: categoriaSafe,\n    drive_root_id: DRIVE_ROOT_ID\n  }\n}];"
      },
      "id": "02-parsear",
      "name": "Parsear & Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-valido",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "03-if-valido",
