          },
          "whatToSearch": "folders"
        }
      },
      "id": "06-buscar-cliente",
      "name": "Buscar Pasta Cliente",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1120, 400],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst ctx = $('Parsear & Validar').first().json;\nconst encontrado = items.length > 0 && items[0].json && items[0].json.id;\n\nreturn [{\n  json: {\n    ...ctx,\n    cliente_existe: !!encontrado,\n    cliente_folder_id: encontrado ? items[0].json.id : null\n  },\n  binary: $('Baixar Arquivo').first().binary || {}\n}];"
      },
