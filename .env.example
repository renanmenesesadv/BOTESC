# ── Banco de Dados ─────────────────────────────────────
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_SEGURA

# ── Telegram API ───────────────────────────
TELEGRAM_BOT_TOKEN=SEU_TOKEN_DO_BOTFATHER_AQUI

# ── n8n ───────────────────────────────────────────────
# Gere com: openssl rand -base64 32
N8N_ENCRYPTION_KEY=GERE_COM_openssl_rand_base64_32
WEBHOOK_URL=https://SEU_IP_DA_VPS:5678/

# ── Google (OAuth para Drive) ──────────────────────────
GOOGLE_CLIENT_ID=SEU_CLIENT_ID
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET

# ── Gemini API ────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_CHAVE_GEMINI

# ── Claude API (Fallback do Gemini) ─────────────────────
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=SUA_CHAVE_ANTHROPIC

# ── Google Drive + Sheets ────────────────────────────────
# Gere rodando: cd bot-api && npm install && node gerar-token-google.js
GOOGLE_REFRESH_TOKEN=GERE_COM_O_SCRIPT
GOOGLE_DRIVE_ROOT_FOLDER_ID=ID_DA_PASTA_RAIZ_NO_DRIVE
GOOGLE_SHEET_ID=ID_DA_PLANILHA
